PORT=2567
# Public label for this deployment, shown in the client region picker.
REGION=local
# Dev only: start a room once this many players joined and the fill timeout passed.
MIN_PLAYERS=
FILL_TIMEOUT_MS=45000

# ---- Twitch chat battles (see docs/TWITCH.md) ----
# Create an app at https://dev.twitch.tv/console/apps
# OAuth Redirect URL there: <PUBLIC_API_URL>/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Any long random string; signs login sessions. Required in production.
SESSION_SECRET=
# Where the web client and this server are reachable from a browser.
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:2567
# Local testing without Twitch: fake logins + chat simulator. Ignored in production.
DEV_FAKE_TWITCH=0
